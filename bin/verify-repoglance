#!/usr/bin/env bash
# verify-repoglance: helpers the verify-repoglance skill drives the app with.
# Approved test phones (.claude/skills/verify-repoglance/devices.tsv) over adb only; never drives any other device.
#
#   bin/verify-repoglance doctor                 # is this device/build worth driving?
#   bin/verify-repoglance launch <scenario> <screen> [repo] [mode] [candidate]   # screen: live|navigator|picker|navigator-picker|splash-picker|status-picker|checking
#   bin/verify-repoglance dump [label]           # uiautomator tree -> runs/verify-repoglance-runs/<run>/<label>.xml (+ .txt)
#   bin/verify-repoglance capture <label>        # inner-display PNG + manifest via phone_proof
#   bin/verify-repoglance tap <resource-id>      # tap the centre of a node by resource-id (from the last dump)
#   bin/verify-repoglance type <text>            # type into the focused field
#   bin/verify-repoglance cleanup                # force-stop, restore MIXED scenario; evidence is kept
set -euo pipefail

PKG="co.saari.repoglance"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
RUN_ID="${VERIFY_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)}"
OUT="$ROOT/runs/verify-repoglance-runs/$RUN_ID"
PHONE_PROOF="${PHONE_PROOF:-$HOME/Developer/SaariusSkills/skills/phone-proof/scripts/phone_proof.py}"
mkdir -p "$OUT"

need() { command -v "$1" >/dev/null 2>&1 || { echo "missing: $1" >&2; exit 2; }; }
# Run "$@" for at most $1 seconds (macOS has no timeout(1)). The command runs
# in its own process group and the whole group is killed, so a child holding
# stdout open can't keep a $(…) waiting.
bounded() {
  perl -e '$t = shift; $p = fork // exit 125;
    if (!$p) { setpgrp(0, 0); exec @ARGV or exit 127 }
    setpgrp($p, $p); $SIG{ALRM} = sub { kill "KILL", -$p; exit 124 };
    alarm $t; waitpid $p, 0; exit($? >> 8)' "$@"
}
serial() { adb devices | awk 'NR>1 && $2=="device"{print $1}'; }

# Approved test phones, keyed by ro.serialno; host-independent.
DEVICES="$ROOT/.claude/skills/verify-repoglance/devices.tsv"
approved_model() { [ -n "$1" ] && awk -F'\t' -v s="$1" '!/^#/ && $1==s {print $2; f=1; exit} END{exit !f}' "$DEVICES"; }

# Pin one transport of one approved phone. A phone can appear more than once
# (USB serial, wireless ip:port, mDNS adb-<serial>-…), so every entry is
# identified by its ro.serialno and counted once; USB is preferred. Exactly
# one approved phone attached: use it. More than one: VERIFY_SERIAL (a
# registry serial or one of its adb transports) must choose, and must be
# approved itself. Every adb call below inherits ANDROID_SERIAL.
pick_serial() {
  [ -f "$DEVICES" ] || { echo "doctor: device registry missing: $DEVICES" >&2; exit 1; }
  local t hw pairs="" seen="" want="${VERIFY_SERIAL:-}"
  for t in $(serial); do
    # A stale or dropped transport (e.g. a tls entry after Wi-Fi loss) must
    # not abort or hang the run; a failed lookup is just an unapproved t(?).
    hw=$(bounded 5 adb -s "$t" shell getprop ro.serialno 2>/dev/null | tr -d '\r' || true)
    seen="$seen $t(${hw:-?})"
    approved_model "$hw" >/dev/null && pairs="$pairs$hw $t"$'\n'
  done
  if [ -n "$want" ]; then
    local pick; pick=$(printf '%s' "$pairs" | awk -v w="$want" '$1==w || $2==w {print $1; exit}')
    [ -n "$pick" ] || { approved_model "$want" >/dev/null \
      && echo "doctor: VERIFY_SERIAL=$want is approved but not attached; attached:${seen:- none}" >&2 \
      || echo "doctor: VERIFY_SERIAL=$want is not in $DEVICES; refusing" >&2; exit 1; }
    pairs=$(printf '%s' "$pairs" | awk -v p="$pick" -v w="$want" '$1==p && (w==p || $2==w)')$'\n'
  fi
  local phones; phones=$(printf '%s' "$pairs" | awk '{print $1}' | sort -u)
  case "$(printf '%s' "$phones" | grep -c .)" in
    0) echo "doctor: no approved phone attached (registry: $DEVICES); found:${seen:- none}" >&2; exit 1 ;;
    1) ;;
    *) echo "doctor: more than one approved phone attached: $(printf '%s' "$phones" | tr '\n' ' '); set VERIFY_SERIAL to choose" >&2; exit 1 ;;
  esac
  DEVICE_SERIAL="$phones"; DEVICE_MODEL=$(approved_model "$DEVICE_SERIAL")
  # USB lists the bare serial; otherwise take the first wireless entry.
  ANDROID_SERIAL=$(printf '%s' "$pairs" | awk '$2==$1 {print $2; exit}')
  [ -n "$ANDROID_SERIAL" ] || ANDROID_SERIAL=$(printf '%s' "$pairs" | awk 'NF {print $2; exit}')
  export ANDROID_SERIAL
}
case "${1:-}" in
  doctor|launch|dump|capture|tap|type|cleanup) need adb; pick_serial ;;
  *) sed -n 2,12p "$0" >&2; exit 2 ;;
esac

# `Committed state: DeviceState{identifier=3, name='OPENED', …}` on newer
# Android, `Committed state: OPENED (3)`-style on older; print the name.
parse_posture() {
  local line; line=$(grep -m1 "Committed state" || true)
  if [[ "$line" =~ name=\'([A-Z_]+)\' ]]; then echo "${BASH_REMATCH[1]}"
  else printf '%s\n' "${line#*Committed state:}" | grep -oE "[A-Z][A-Z_]+" | head -1 || true; fi
}

# The installed base APK's device path, or empty when the package is absent
# (`pm path` then exits 1, which must not end the run).
device_apk_path() { adb shell pm path "$PKG" 2>/dev/null | head -1 | sed 's/^package://' | tr -d '\r' || true; }
awake_state() { adb shell dumpsys power | grep -m1 -oE "mWakefulness=[A-Za-z]+" | cut -d= -f2 || true; }

doctor() {
  need adb
  echo "serial=$DEVICE_SERIAL model=$DEVICE_MODEL transport=$ANDROID_SERIAL"
  # Every lookup below may come back empty (package not installed, a dumpsys
  # line missing); under pipefail that must print unknown/absent, not exit.
  local model; model=$(adb shell getprop ro.product.model | tr -d '\r') \
    || { echo "doctor: adb shell failed on $ANDROID_SERIAL; reconnect the phone" >&2; exit 1; }
  local apk="$ROOT/app/build/outputs/apk/debug/app-debug.apk"
  local local_sha="absent" dev_sha="" ver="" path
  [ -f "$apk" ] && local_sha=$(shasum -a 256 "$apk" | cut -c1-64)
  path=$(device_apk_path)
  if [ -n "$path" ]; then
    ver=$(adb shell dumpsys package "$PKG" | grep -m1 versionName | tr -d ' \r' || true)
    adb pull "$path" "$OUT/device-base.apk" >/dev/null 2>&1 && dev_sha=$(shasum -a 256 "$OUT/device-base.apk" | cut -c1-64) && rm -f "$OUT/device-base.apk"
  fi
  # Resolve the explicit component: the launcher is exported with no intent
  # filter, so it never shows in pm dump's resolver tables on newer Android.
  local launcher; launcher=$(adb shell cmd package resolve-activity --components -n "$PKG/.devlaunch.ScenarioLaunchActivity" 2>/dev/null | tr -d '\r' | grep -c "^$PKG/.*devlaunch\.ScenarioLaunchActivity$" || true)
  if [ -n "$path" ]; then echo "device=$model package=$PKG $ver"; else echo "device=$model package=absent"; fi
  echo "apk_local=$local_sha"
  echo "apk_device=$dev_sha"
  echo "scenario_launcher_present=$([ "${launcher:-0}" -gt 0 ] && echo yes || echo no)"
  local posture keyguard wake
  posture=$(adb shell cmd device_state state 2>/dev/null | tr -d '\r' | parse_posture || true)
  wake=$(awake_state)
  keyguard=$(adb shell dumpsys trust 2>/dev/null | grep -m1 -oE "deviceLocked=[01]" | cut -d= -f2 || true)
  echo "posture=${posture:-unknown} wakefulness=${wake:-unknown} device_locked=${keyguard:-unknown}"
  echo "run_dir=$OUT"
  [ -n "$path" ] || { echo "doctor: RepoGlance is not installed; run 'launch' to install" >&2; exit 1; }
  [ "$wake" = "Awake" ] && [ "${keyguard:-1}" = "0" ] || { echo "doctor: phone must be awake and unlocked; it is wakefulness=${wake:-unknown} device_locked=${keyguard:-unknown}" >&2; exit 1; }
  [ "$local_sha" = "$dev_sha" ] || { echo "doctor: device APK does not match the local build; run 'launch' to install" >&2; exit 1; }
  [ "${launcher:-0}" -gt 0 ] || { echo "doctor: debug launcher missing; this is not a debug build" >&2; exit 1; }
}

launch() {
  need adb
  local scenario="${1:-MIXED}" screen="${2:-live}" repo="${3:-acme/rocket}" mode="${4:-BOTH}" candidate="${5:-}"
  local apk="$ROOT/app/build/outputs/apk/debug/app-debug.apk"
  [ -f "$apk" ] || { echo "launch: build first: ./gradlew assembleDebug" >&2; exit 1; }
  local local_sha dev_sha path
  local_sha=$(shasum -a 256 "$apk" | cut -c1-64)
  path=$(device_apk_path)
  dev_sha=""
  if [ -n "$path" ]; then
    adb pull "$path" "$OUT/.device-base.apk" >/dev/null 2>&1 && dev_sha=$(shasum -a 256 "$OUT/.device-base.apk" | cut -c1-64); rm -f "$OUT/.device-base.apk"
  fi
  if [ "$local_sha" != "$dev_sha" ]; then
    local out; out=$(adb install -r "$apk" 2>&1) || { echo "launch: install failed: $out" >&2; exit 1; }
  fi
  local expect marker
  case "$screen" in
    picker) expect="devpicker.WidgetVariantPickerActivity"; marker="PRODUCTION" ;;
    navigator-picker) expect="devpicker.NavigatorVariantPickerActivity"; marker="deciding: what a row TAP does" ;;
    splash-picker) expect="devpicker.SplashVariantPickerActivity"; marker="checking-splash-018" ;;
    status-picker) expect="devpicker.StatusColourVariantPickerActivity"; marker="family-look" ;;
    checking) expect="devlaunch.CheckingPreviewActivity"; marker="repoglance:checking-mark" ;;
    signin-finishing) expect="devlaunch.SignInFinishingPreviewActivity"; marker="repoglance:signin-mark" ;;
    navigator) expect="co.saari.repoglance/.MainActivity"; marker="repoglance:fixture-home" ;;
    *) expect="co.saari.repoglance/.MainActivity"; marker="" ;;
  esac
  local attempt top ok
  for attempt in 1 2; do
    adb shell am force-stop "$PKG"; sleep 1
    adb shell am force-stop com.github.android 2>/dev/null || true
    adb shell am start -W -n "$PKG/.devlaunch.ScenarioLaunchActivity" \
      --es scenario "$scenario" --es screen "$screen" --es repo "$repo" --es mode "$mode" \
      ${candidate:+--es candidate "$candidate"} >/dev/null 2>&1 || true
    ok=""
    for _ in 1 2 3 4 5 6 7 8; do
      sleep 1
      top=$(adb shell dumpsys activity activities 2>/dev/null | grep -m1 topResumedActivity | sed -E 's/.*u0 //; s/ t[0-9]+}//' || true)
      case "$top" in *"$expect"*) ;; *) continue ;; esac
      if [ -z "$marker" ]; then ok=1; break; fi
      adb shell uiautomator dump /sdcard/verify-ui.xml >/dev/null 2>&1 && adb shell cat /sdcard/verify-ui.xml 2>/dev/null | grep -qF "$marker" && { ok=1; break; }
    done
    [ -n "$ok" ] && break
    echo "launch: attempt $attempt did not reach $screen (top=$top); retrying" >&2
  done
  [ -n "$ok" ] || { echo "launch: failed to reach $screen after 2 attempts (top=$top)" >&2; exit 1; }
  echo "$top"
}

# Stream the current UI tree from the device through the redaction guard in
# memory (scripts/verify_redact_guard.py). No file exists on the phone or the
# host until the guard has passed; on refusal nothing is written anywhere.
# Returns the guard's code: 1 device-code screen, 2 no usable tree.
pull_tree() {
  local dest="$1" tree
  tree=$(adb exec-out uiautomator dump /dev/tty 2>/dev/null | python3 "$ROOT/scripts/verify_redact_guard.py") || return
  [ -n "$tree" ] || return 2
  printf '%s\n' "$tree" > "$dest"
}

dump() {
  need adb
  local label="${1:-screen}"
  local rc=0; pull_tree "$OUT/$label.xml" || rc=$?
  [ "$rc" = 1 ] && { echo "dump: refused; the device-code screen is visible" >&2; exit 1; }
  [ "$rc" = 0 ] || { echo "dump: no UI tree from the phone (uiautomator dump failed)" >&2; exit 1; }
  cp "$OUT/$label.xml" "$OUT/last-dump.xml"
  python3 - "$OUT/$label.xml" > "$OUT/$label.txt" <<'PY'
import sys, xml.etree.ElementTree as ET
r = ET.parse(sys.argv[1]).getroot()
for n in r.iter('node'):
    rid = n.get('resource-id') or ''
    t = n.get('text') or ''
    d = n.get('content-desc') or ''
    if rid or t or d:
        print(f"{rid or '-'} | {t} | {d} | {n.get('bounds')}")
PY
  echo "$OUT/$label.txt"
}

capture() {
  need python3
  local label="${1:-capture}"
  local screen; screen=$(awake_state)
  [ "$screen" = "Awake" ] || { echo "capture: screen is ${screen:-unknown}, not Awake; wake and unlock the phone first" >&2; exit 1; }
  local rc=0; adb exec-out uiautomator dump /dev/tty 2>/dev/null | python3 "$ROOT/scripts/verify_redact_guard.py" >/dev/null || rc=$?
  [ "$rc" = 1 ] && { echo "capture: refused; the device-code screen is visible" >&2; exit 1; }
  [ "$rc" = 0 ] || { echo "capture: no UI tree from the phone, so the device-code guard cannot run" >&2; exit 1; }
  local display; display=$(python3 "$PHONE_PROOF" --serial "$ANDROID_SERIAL" inventory | python3 -c "import json,sys; d=json.load(sys.stdin); a=[x for x in d['physical_displays'] if x['active'] and not x['virtual']]; print(a[0]['physical_display_id'] if len(a)==1 else '')")
  [ -n "$display" ] || { echo "capture: no single active physical display (is the phone folded mid-transition?)" >&2; exit 1; }
  python3 "$PHONE_PROOF" --serial "$ANDROID_SERIAL" capture --physical-display-id "$display" \
    --output "$OUT/$label.png" --manifest "$OUT/$label.json" \
    | python3 -c "import json,sys; d=json.load(sys.stdin)['capture']; print(f\"$OUT/$label.png sha256={d['sha256']} bytes={d['bytes']}\")"
}

tap() {
  need adb
  local rid="$1"
  [ -f "$OUT/last-dump.xml" ] || dump pre-tap >/dev/null || exit 1
  local xy; xy=$(python3 - "$OUT/last-dump.xml" "$rid" <<'PY'
import sys, re, xml.etree.ElementTree as ET
r = ET.parse(sys.argv[1]).getroot(); want = sys.argv[2]
nodes = list(r.iter('node'))
exact = [n for n in nodes if n.get('resource-id') == want or n.get('content-desc') == want or n.get('text') == want]
prefix = [n for n in nodes if (n.get('text') or '').startswith(want) or (n.get('content-desc') or '').startswith(want)]
for n in (exact or prefix)[:1]:
    x1,y1,x2,y2 = map(int, re.findall(r'\d+', n.get('bounds'))); print((x1+x2)//2, (y1+y2)//2)
PY
)
  [ -n "$xy" ] || { echo "tap: '$rid' not in last dump" >&2; exit 1; }
  adb shell input -d 0 tap $xy
  echo "tapped $rid at $xy"
}

type_text() { need adb; adb shell input text "$(printf '%s' "$1" | sed 's/ /%s/g')"; echo "typed"; }

cleanup() {
  need adb
  adb shell am force-stop "$PKG" || true
  adb shell am force-stop com.github.android 2>/dev/null || true
  adb shell am start -n "$PKG/.devlaunch.ScenarioLaunchActivity" --es scenario MIXED --es screen live >/dev/null 2>&1 || true
  sleep 1; adb shell am force-stop "$PKG" || true
  adb shell settings get global airplane_mode_on | grep -q 1 && adb shell cmd connectivity airplane-mode disable || true
  echo "cleanup: app stopped, scenario restored to MIXED, airplane mode off; evidence kept in $OUT"
}

case "${1:-}" in
  doctor) doctor ;;
  launch) shift; launch "$@" ;;
  dump) shift; dump "$@" ;;
  capture) shift; capture "$@" ;;
  tap) shift; tap "$@" ;;
  type) shift; type_text "$@" ;;
  cleanup) cleanup ;;
esac
