<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only overlay. The GrillTrack variant picker is development tooling and
  must never enter a release build; keeping it in the debug source set is what
  enforces that.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="co.saari.repoglance.devpicker.WidgetVariantPickerActivity"
            android:exported="true"
            android:label="GrillTrack widget picker" />
        <activity
            android:name="co.saari.repoglance.devpicker.NavigatorVariantPickerActivity"
            android:exported="true"
            android:label="GrillTrack navigator picker" />
        <activity
            android:name="co.saari.repoglance.devpicker.SplashVariantPickerActivity"
            android:exported="true"
            android:label="GrillTrack checking-splash picker" />
        <activity
            android:name="co.saari.repoglance.devpicker.StatusColourVariantPickerActivity"
            android:exported="true"
            android:label="GrillTrack status-colour picker" />
        <activity
            android:name="co.saari.repoglance.devpicker.LabelTypeVariantPickerActivity"
            android:exported="true"
            android:label="GrillTrack label-typography picker" />
        <activity
            android:name="co.saari.repoglance.devpicker.ShapeVariantPickerActivity"
            android:exported="true"
            android:label="GrillTrack shape picker" />
        <activity
            android:name="co.saari.repoglance.devpicker.WidgetLookVariantPickerActivity"
            android:exported="true"
            android:label="GrillTrack widget-look picker" />
        <activity
            android:name="co.saari.repoglance.devpicker.CompactVariantPickerActivity"
            android:exported="true"
            android:label="GrillTrack compact-widget picker" />
        <activity
            android:name="co.saari.repoglance.devpicker.SampleMarkerPickerActivity"
            android:exported="true"
            android:label="GrillTrack sample-marker picker" />
        <activity
            android:name="co.saari.repoglance.devpicker.WidgetPreviewPickerActivity"
            android:exported="true"
            android:label="GrillTrack widget-preview picker" />
        <activity
            android:name="co.saari.repoglance.devlaunch.WidgetStateSeedActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:label="verify-repoglance widget state seed" />
        <activity
            android:name="co.saari.repoglance.devlaunch.CheckingPreviewActivity"
            android:exported="true"
            android:label="verify-repoglance checking preview" />
        <activity
            android:name="co.saari.repoglance.devlaunch.SignInFinishingPreviewActivity"
            android:exported="true"
            android:label="verify-repoglance sign-in finishing preview" />
        <activity
            android:name="co.saari.repoglance.devlaunch.ScenarioLaunchActivity"
            android:exported="true"
            android:label="verify-repoglance scenario launcher"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
