<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.github.android" />
    </queries>

    <!-- No <uses-permission> elements. RepoGlance is read-only and has no
         network stack in this slice or any planned one that bypasses the
         GitHub App auth flow — the absence of android.permission.INTERNET
         here is itself proof of no network access. -->

    <application
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.RepoWidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_config_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Both receivers must be exported: APPWIDGET_UPDATE is broadcast
             by the system widget host, an external caller. Neither accepts
             any other intent, and both are fixture-mode-only (no network,
             no write). -->
        <receiver
            android:name=".widget.RepoWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/repo_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.StackWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stack_widget_info" />
        </receiver>
    </application>

</manifest>
