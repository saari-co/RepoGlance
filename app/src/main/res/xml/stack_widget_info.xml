<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis is 0: the app redraws this widget through
     WidgetRefresh after a live pin change and each 30-minute WorkManager
     refresh of the pinned set. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_loading"
    android:description="@string/widget_stack_description"
    android:updatePeriodMillis="0" />
