<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis is 0: the app redraws this widget through
     WidgetRefresh after an in-app repository open, a widget save, and each
     30-minute WorkManager refresh of the pinned set. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:configure="co.saari.repoglance.widget.RepoWidgetConfigActivity"
    android:widgetFeatures="reconfigurable"
    android:initialLayout="@layout/widget_loading"
    android:description="@string/widget_repo_description"
    android:updatePeriodMillis="0" />
